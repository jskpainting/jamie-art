# Supabase — create a project at supabase.com and copy these from Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Resend — for newsletter sends (Phase 5)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@jamiekendrioski.com

# Site URL — http://localhost:7847 locally, https://jamiekendrioski.com in production
NEXT_PUBLIC_SITE_URL=http://localhost:7847

# Set 'true' to skip admin auth in dev. NEVER set this on Vercel.
ADMIN_AUTH_BYPASS=false

# The ONLY emails allowed to sign in to /admin. Comma-separated, no spaces
# needed. Anyone whose email is not on this list is blocked, even if they
# receive a magic link. This is the master admin list — edit it here (local)
# and in Vercel > Settings > Environment Variables (production).
ADMIN_EMAILS=jamie@example.com,second.admin@example.com
