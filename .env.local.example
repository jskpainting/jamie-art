# Supabase — create a project at supabase.com and copy these from Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Resend — for newsletter sends (Phase 5)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@jamiekendrioski.com

# Site URL — http://localhost:7847 locally, https://jamiekendrioski.com in production
NEXT_PUBLIC_SITE_URL=http://localhost:7847

# Set 'true' to skip admin auth in dev. NEVER set this on Vercel.
ADMIN_AUTH_BYPASS=false
